# MarsAtlas Environment Configuration Template
# Copy this file to .env.local (frontend) or .env (backend) and adjust variables as needed.

# ==========================================
# Frontend Configuration (Next.js)
# ==========================================
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_MARS_TREK_API_BASE=https://trek.nasa.gov/tiles/Mars/EQ
NEXT_PUBLIC_DEFAULT_STUDY_SITE=jezero

# ==========================================
# Backend Configuration (FastAPI)
# ==========================================
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==========================================
# Optional NASA Open API Key
# ==========================================
# NASA Open APIs default to DEMO_KEY (30 req/hr).
# Obtain an official production key from https://api.nasa.gov
NASA_API_KEY=DEMO_KEY
